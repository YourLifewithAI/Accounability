# --- Accountability platform configuration ---

# Data mode. When live sources are unreachable (e.g. missing keys, or a sandbox
# with a network egress allowlist), the app serves clearly-labeled SAMPLE data.
# Set to "1" to attempt live API calls (requires the keys below + network egress
# to the source hosts).
ACCOUNTABILITY_LIVE=0

# FEC / OpenFEC API key — https://api.open.fec.gov/developers/
# Free key from https://api.data.gov/signup/ . "DEMO_KEY" works at low limits.
FEC_API_KEY=DEMO_KEY

# FollowTheMoney (National Institute on Money in Politics) API key.
# Free account → https://www.followthemoney.org/ → API key in dashboard.
FTM_API_KEY=

# NOTE on network egress: the live source hosts are
#   api.open.fec.gov, api.usaspending.gov, unitedstates.github.io
# If you run this inside a sandbox with an egress allowlist, add those hosts.
# USAspending requires no key.
